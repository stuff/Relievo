{
  "name": "relievo",
  "version": "0.1.0",
  "description": "Relievo: a React design system built on Base UI",
  "license": "MIT",
  "author": {
    "name": "Nicolas Challeil (aka STuFF)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuff/Relievo.git"
  },
  "homepage": "https://github.com/stuff/Relievo#readme",
  "bugs": {
    "url": "https://github.com/stuff/Relievo/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "base-ui",
    "css-modules",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2",
      "onFail": "warn"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass-embedded": "^1.104.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
